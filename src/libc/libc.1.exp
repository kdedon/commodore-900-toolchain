# ---- data exports ----------------------------------------------------------
#
# The second word must match the object, or slgen refuses the library.
# Bare names above are functions.
#
#	data	per-process object in the private segment
#	shrd	`readonly' table in the shared segment, one copy system-wide
#
# Clients reach functions through stubs and objects through slots, so a
# table losing `readonly' silently becomes per-process: keep this column.
_ctype_		shrd
signame_	shrd
sys_errlist_	shrd
_fp_		data
_stderr_	data
_stdin_		data
_stdout_	data
environ_	data
optarg_		data
opterr_		data
optind_		data
optopt_		data
sys_nerr_	data
timezone_	data
tzname_		data
